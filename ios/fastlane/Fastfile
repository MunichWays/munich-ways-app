skip_docs

require "base64"
require "fileutils"
require "securerandom"
require "tmpdir"

default_platform(:ios)

# Shared App Store Connect API key for pilot/deliver when ASC_* env vars are set.
# Returns nil if API key is not configured (TestFlight upload may use app-specific password instead).
def app_store_connect_api_key_from_env
  key_id = ENV["ASC_KEY_ID"].to_s
  issuer_id = ENV["ASC_ISSUER_ID"].to_s
  return nil if key_id.empty? || issuer_id.empty?

  key_path = ENV["ASC_KEY_PATH"].to_s
  key_content_b64 = ENV["ASC_KEY_CONTENT_BASE64"].to_s

  if !key_path.empty?
    expanded = File.expand_path(key_path, Dir.pwd)
    UI.user_error!("ASC_KEY_PATH does not exist: #{expanded}") unless File.file?(expanded)
    app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_filepath: expanded,
      duration: 1200,
      in_house: false
    )
  elsif !key_content_b64.empty?
    app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_content: key_content_b64,
      is_key_content_base64: true,
      duration: 1200,
      in_house: false
    )
  else
    UI.user_error!("ASC_KEY_ID and ASC_ISSUER_ID are set: add ASC_KEY_PATH or ASC_KEY_CONTENT_BASE64 for API key upload.")
  end
end

platform :ios do
  desc "Create/update cert+profile and upload TestFlight build"
  lane :beta do
    # 0a) Regenerate ios/Flutter/Generated.xcconfig from pubspec.yaml. CFBundleShortVersionString/
    #     CFBundleVersion in Info.plist read $(FLUTTER_BUILD_NAME)/$(FLUTTER_BUILD_NUMBER) from that
    #     file, but it's only written by the `flutter` CLI — build_app below calls xcodebuild
    #     directly and would otherwise archive whatever version was cached from the last `flutter
    #     build`/`flutter run`, silently diverging from pubspec.yaml.
    repo_root = File.expand_path("../..", __dir__)
    geoapify_key = ENV["GEOAPIFY_API_KEY"].to_s
    dart_defines = geoapify_key.empty? ? "" : %( --dart-define=GEOAPIFY_API_KEY="#{geoapify_key}")
    sh(%(cd "#{repo_root}" && flutter build ios --release --no-codesign#{dart_defines}))

    # 0b) A dev machine's login keychain already holds the distribution certificate, so
    #     `cert` below just finds it. A GitHub Actions runner starts with an empty keychain
    #     each run, so import IOS_DIST_CERT_P12_BASE64 into a throwaway keychain first —
    #     otherwise `cert` (force: false) sees the cert already exists in the Developer
    #     Portal, but has no private key on disk to install it with, and fails.
    if ENV["CI"] == "true"
      keychain_password = SecureRandom.hex(16)
      create_keychain(
        name: "ci-signing",
        password: keychain_password,
        default_keychain: true,
        unlock: true,
        timeout: 3600,
        lock_when_sleeps: false
      )
      p12_base64 = ENV["IOS_DIST_CERT_P12_BASE64"].to_s
      UI.user_error!("Set IOS_DIST_CERT_P12_BASE64 (and IOS_DIST_CERT_P12_PASSWORD) for CI signing.") if p12_base64.empty?
      p12_path = File.join(Dir.mktmpdir, "dist_cert.p12")
      File.binwrite(p12_path, Base64.decode64(p12_base64))
      import_certificate(
        certificate_path: p12_path,
        certificate_password: ENV["IOS_DIST_CERT_P12_PASSWORD"].to_s,
        keychain_name: "ci-signing",
        keychain_password: keychain_password
      )
    end

    # 0c) Register ASC API key (if present) so cert/sigh/upload_to_testflight all use it
    #    instead of prompting for an Apple ID login. Must run before cert/sigh.
    asc_key = app_store_connect_api_key_from_env
    # 1) Ensure distribution certificate exists in keychain
    # `cert`'s own keychain_path param defaults to login.keychain-db regardless of which
    # keychain create_keychain/import_certificate above set up — it doesn't follow the OS
    # default keychain. In CI, point it at ci-signing explicitly, or it won't find the
    # cert we just imported there and will (needlessly) generate a new one instead.
    cert_params = { development: false, force: false }
    cert_params[:keychain_path] = "ci-signing" if ENV["CI"] == "true"
    cert(cert_params)
    # 2) Create/download App Store provisioning profile
    sigh(
      app_identifier: "com.munichways.app",
      force: false
    )
    # 3) Build with explicit export options/profile mapping
    # The Xcode project uses Automatic signing, which needs an Xcode-level Apple ID
    # session. We're authenticating via ASC API key instead, so force manual signing
    # at archive time using the certificate/profile cert+sigh just installed.
    team_id = CredentialsManager::AppfileConfig.try_fetch_value(:team_id)
    build_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      export_method: "app-store",
      xcargs: [
        "CODE_SIGN_STYLE=Manual",
        "CODE_SIGN_IDENTITY=\"Apple Distribution\"",
        "PROVISIONING_PROFILE_SPECIFIER=#{lane_context[SharedValues::SIGH_UUID]}",
        "DEVELOPMENT_TEAM=#{team_id}"
      ].join(" ")
    )
    # 4) Upload to TestFlight
    upload_options = { skip_waiting_for_build_processing: true }
    upload_options[:api_key] = asc_key if asc_key
    upload_to_testflight(upload_options)
  end

  desc "Upload App Store listing metadata from fastlane/metadata (no IPA, no screenshots). " \
       "Set APP_STORE_VERSION to target a specific App Store version (e.g. 3.0.0)."
  lane :metadata do
    deliver_options = {
      skip_binary_upload: true,
      skip_screenshots: true,
      force: true,
      submit_for_review: false,
      automatic_release: false,
      # Listing-only: do not run precheck as if we were submitting a binary
      run_precheck_before_submit: false
    }

    v = ENV["APP_STORE_VERSION"].to_s
    deliver_options[:app_version] = v unless v.empty?

    k = app_store_connect_api_key_from_env
    deliver_options[:api_key] = k if k

    deliver(deliver_options)
  end

  desc "Capture App Store marketing screenshots (Flutter integration_test on iOS Simulator). " \
       "Requires a booted simulator: set SCREENSHOT_SIMULATOR_UDID (see `xcrun simctl list devices booted`). " \
       "Writes PNGs under Library/Caches/store_screenshots (iOS path_provider cache). Flutter uninstalls the app when the test exits, " \
       "so this lane polls simctl during the run and copies PNGs to <repo>/integration_test/screenshots/, then fastlane/screenshots/de-DE/."
  lane :screenshots do
    # __dir__ is ios/fastlane — Flutter project root is two levels up (where pubspec.yaml lives).
    repo_root = File.expand_path("../..", __dir__)
    ios_dir = File.join(repo_root, "ios")
    pod_binstubs = File.join(ios_dir, "vendor", "bundle_binstubs")

    udid = ENV["SCREENSHOT_SIMULATOR_UDID"].to_s.strip
    if udid.empty?
      UI.user_error!(
        "Set SCREENSHOT_SIMULATOR_UDID to a booted iOS Simulator UDID " \
        "(Xcode → Window → Devices and Simulators, or `xcrun simctl list devices booted`)."
      )
    end

    # Flutter validates `pod` on PATH; a system/Homebrew pod tied to another Ruby often breaks.
    # ios/Gemfile pins CocoaPods — binstubs put a working `pod` first on PATH for this lane.
    # Bundler 4 removed `bundle binstubs --path=…`; use `bundle config set bin` (local to ios/).
    sh(%(cd "#{ios_dir}" && bundle install))
    sh(
      %(cd "#{ios_dir}" && ) +
        %(bundle config set --local bin vendor/bundle_binstubs && ) +
        %(bundle binstubs cocoapods --force)
    )
    sh(%(cd "#{ios_dir}" && bundle exec pod install))

    bundle_id = "com.munichways.app"
    # Best-effort: grant location and pin Stachus so routing has a start fix.
    sh(%(xcrun simctl privacy "#{udid}" grant location #{bundle_id}))
    # simctl expects one "lat,lon" token (comma-separated), not two arguments.
    sh(%(xcrun simctl location "#{udid}" set 48.14,11.5652))

    host_shots = File.join(repo_root, "integration_test", "screenshots")
    FileUtils.mkdir_p(host_shots)

    # `flutter test` integration runs uninstall the app on teardown, so a single
    # post-run `get_app_container` often sees ENOENT. Poll while the test runs.
    stop_polling = false
    poller = Thread.new do
      until stop_polling
        begin
          app_data = `xcrun simctl get_app_container "#{udid}" #{bundle_id} data 2>/dev/null`.strip
          unless app_data.empty?
            # iOS/macOS: getTemporaryDirectory() / getApplicationCacheDirectory() → NSCachesDirectory (Library/Caches), not tmp/.
            sim_shots = File.join(app_data, "Library", "Caches", "store_screenshots")
            if Dir.exist?(sim_shots)
              Dir.glob(File.join(sim_shots, "*.png")).each do |src|
                FileUtils.cp(src, host_shots) if File.file?(src)
              end
            end
          end
        rescue StandardError
          # Transient while the app is installing or simctl is busy.
        end
        sleep(0.15)
      end
    end

    previous_path = ENV["PATH"]
    ENV["PATH"] = [pod_binstubs, previous_path].compact.join(File::PATH_SEPARATOR)
    flutter_test_failed = false
    begin
      sh(
        %(cd "#{repo_root}" && ) +
          %(flutter test integration_test/screenshots_test.dart ) +
          %(-d "#{udid}" --dart-define=STORE_SCREENSHOTS=true)
      )
    rescue StandardError => e
      flutter_test_failed = true
      UI.important("flutter test failed (#{e.message}) — still collecting any screenshots from the simulator.")
    ensure
      ENV["PATH"] = previous_path
      stop_polling = true
      poller.join(5)
      poller.kill if poller.alive?
    end

    # Best-effort final copy (sometimes the app is still registered briefly).
    app_data = `xcrun simctl get_app_container "#{udid}" #{bundle_id} data 2>/dev/null`.strip
    sim_shots = File.join(app_data, "Library", "Caches", "store_screenshots")
    if !app_data.empty? && Dir.exist?(sim_shots)
      Dir.glob(File.join(sim_shots, "*.png")).each { |f| FileUtils.cp(f, host_shots) }
    end

    host_pngs = Dir.glob(File.join(host_shots, "*.png"))
    if host_pngs.empty?
      UI.important("No PNGs in #{host_shots} — check bundle id com.munichways.app and Library/Caches/store_screenshots in the test.")
    else
      UI.success("Collected #{host_pngs.length} screenshot(s) into #{host_shots}")
    end

    dest = File.expand_path("screenshots/de-DE", __dir__)
    FileUtils.mkdir_p(dest)
    if Dir.exist?(host_shots)
      Dir.glob(File.join(host_shots, "*.png")).each { |f| FileUtils.cp(f, dest) }
      UI.success("Copied screenshots to #{dest}")
    end

    UI.user_error!("flutter test integration_test/screenshots_test.dart failed") if flutter_test_failed
  end

  desc "Upload App Store metadata and screenshots from fastlane/screenshots (same as ios metadata but skip_screenshots: false)."
  lane :metadata_and_screenshots do
    deliver_options = {
      skip_binary_upload: true,
      skip_screenshots: false,
      force: true,
      submit_for_review: false,
      automatic_release: false,
      run_precheck_before_submit: false
    }

    v = ENV["APP_STORE_VERSION"].to_s
    deliver_options[:app_version] = v unless v.empty?

    k = app_store_connect_api_key_from_env
    deliver_options[:api_key] = k if k

    deliver(deliver_options)
  end

  desc "Submit the current App Store version for review (metadata must already match ASC rules). " \
       "Requires a build attached in App Store Connect. Set CONFIRM_SUBMIT=1."
  lane :submit_review do
    UI.user_error!("Set CONFIRM_SUBMIT=1 to submit this app version for App Review.") unless ENV["CONFIRM_SUBMIT"] == "1"

    deliver_options = {
      skip_binary_upload: true,
      skip_screenshots: true,
      submit_for_review: true,
      automatic_release: false,
      run_precheck_before_submit: true,
      force: true
    }

    v = ENV["APP_STORE_VERSION"].to_s
    deliver_options[:app_version] = v unless v.empty?

    k = app_store_connect_api_key_from_env
    deliver_options[:api_key] = k if k

    deliver(deliver_options)
  end
end
